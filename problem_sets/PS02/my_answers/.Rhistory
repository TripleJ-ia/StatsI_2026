find_std_residual <- function(df) {
df_margin <- addmargins(df)
for (i in 1:(ncol(df_margin)-1)) {
for (j in 1:(nrow(df_margin)-1)) {
#print(df_margin[j,i])
observed <- df_margin[j,i]
rol_total <- df_margin[j,ncol(df_margin)]
col_total <- df_margin[nrow(df_margin),i]
total <- df_margin[nrow(df_margin),ncol(df_margin)]
observed
rol_total
col_total
total
print('')
}
}
}
find_std_residual(df)
