geom_point(size = 0.8, alpha = 0.5) +
geom_smooth(method = "lm", se = TRUE) +
labs(x = "Presvote residuals (part not explained by difflog", y = "Voteshare residuals (part not explained by difflog)", title = "q2 residual vs q1 residual")
