y <- c(105, 69, 86, 100, 82, 111, 104, 110, 87, 108, 87, 90, 94, 113, 112, 98, 80, 97, 95, 111, 114, 89, 95, 126, 98)
mean_y <- mean(y)
sd_y <- sd(y)
standard_error <- sd_y / sqrt(length(y))
confident_interval <- c(mean_y, mean_y) + c(standard_error, -standard_error)
summary_y <- summary(y)
summary_y
summary_y <- t.test(y, conf.level = 0.90)$conf.int
se <- s_y / sqrt(length(y))
s_y <- sd(y)
# at 90% Confidence interval, df = 25-1 = 24, t-score is 2.064 for two-tail probabilities.
se <- s_y / sqrt(length(y))
confident_interval <- c(mean_y, mean_y) + c(-se, se)
confident_interval
y <- c(105, 69, 86, 100, 82, 111, 104, 110, 87, 108, 87, 90, 94, 113, 112, 98, 80, 97, 95, 111, 114, 89, 95, 126, 98)
# find mean and SD to create a CI
mean_y <- mean(y)
s_y <- sd(y)
# at 90% Confidence interval, df = 25-1 = 24, t-score is 2.064 for two-tail probabilities.
se <- s_y / sqrt(length(y))
confident_interval <- c(mean_y, mean_y) + c(-se, se)
confident_interval
# check work with summary
summary_y <- t.test(y, conf.level = 0.90)$conf.int
se <- s_y / sqrt(length(y))
t <- 2.064
confident_interval <- c(mean_y, mean_y) + c(-t*se, t*se)
confident_interval
# check work with summary
summary_y <- t.test(y, conf.level = 0.90)$conf.int
y <- c(105, 69, 86, 100, 82, 111, 104, 110, 87, 108, 87, 90, 94, 113, 112, 98, 80, 97, 95, 111, 114, 89, 95, 126, 98)
# 1
# find mean and SD to create a CI
mean_y <- mean(y)
s_y <- sd(y)
# at 90% Confidence interval, df = 25-1 = 24, t-score is 2.064 for two-tail probabilities.
se <- s_y / sqrt(length(y))
t <- 2.064
ci_lower <- mean_y - t*se
ci_upper <- mean_y + t*se
confident_interval <- c(ci_lower, ci_upper)
confident_interval
ci <- t.test(y, conf.level = 0.90)$conf.int
ci <- round(t.test(y, conf.level = 0.90)$conf.int, 4)
